---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';
import { createHreflangAlternates } from '../lib/seo';

const { Content, data } = await getPage('about', 'en');
---

<BaseLayout
  title="About David Silva | Software Engineer"
  description={data.description}
  pageKind="profile"
  alternates={createHreflangAlternates('/about/', '/pt/about/')}
>
  <h1>{data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>

<style>
  .prose :global(ul) {
    padding-left: var(--space-5);
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
</style>
