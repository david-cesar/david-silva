---
import BaseLayout from '../layouts/BaseLayout.astro';
import RotatingText from '../components/RotatingText.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, postHref } from '../lib/blog';

const roles = ['software engineer', 'teacher', 'dungeon master'];

const posts = await getPosts('en');
const latest = posts.slice(0, 3);
const rest = posts.slice(3);
---

<BaseLayout>
  <h1 class="hero">
    David Silva, a <RotatingText items={roles} />
  </h1>
  <p>
    I build AI systems that run in production, the multi-agent kind, where the
    hard part is getting many moving pieces to behave.
  </p>
  <p>
    The thread between all of it is the same: I like turning complexity into
    something clear enough to hand to another person.
  </p>

  {
    latest.length > 0 && (
      <section>
        <h2>Latest posts</h2>
        {latest.map((post) => (
          <PostCard
            href={postHref(post.id, 'en')}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            lang="en"
          />
        ))}
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section>
        <h2>Posts</h2>
        <ul class="post-list">
          {rest.map((post) => (
            <li>
              <a href={postHref(post.id, 'en')}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
  }
  section {
    margin-top: var(--space-6);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-list li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }
  .post-list a {
    color: var(--text);
  }
  .post-list a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
