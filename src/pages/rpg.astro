---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage } from '../lib/pages';

const { Content, data } = await getPage('rpg', 'en');
---

<BaseLayout title={`${data.title} · David Silva`} description={data.description}>
  <h1>{data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>

<style>
  .prose :global(ul) {
    padding-left: var(--space-5);
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
  .prose :global(p:last-child) {
    color: var(--muted);
    font-style: italic;
  }
</style>
