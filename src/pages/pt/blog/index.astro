---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts } from '../../../lib/blog';
import { createHreflangAlternates } from '../../../lib/seo';

const posts = await getPosts('pt');
---

<BaseLayout
  title="Blog de Engenharia de IA | David Silva"
  description="Textos práticos sobre engenharia de IA, sistemas em produção e decisões para construir software que funcione."
  lang="pt-BR"
  pageKind="collection"
  alternates={createHreflangAlternates('/blog/', '/pt/blog/')}
>
  <h1>Blog</h1>
  {
    posts.length === 0 ? (
      <p>Nenhum post ainda.</p>
    ) : (
      posts.map((post) => (
        <PostCard
          href={`/pt/blog/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          lang="pt"
        />
      ))
    )
  }
</BaseLayout>
