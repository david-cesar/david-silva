---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import { getPosts, getTags, tagSlug, postHref } from '../../../../lib/blog';

export async function getStaticPaths() {
  const tags = await getTags('pt');
  const posts = await getPosts('pt');
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`Posts com a tag "${tag}" · David Silva`}
  description={`Posts com a tag ${tag}.`}
  lang="pt-BR"
>
  <p class="crumb"><a href="/pt/blog/">← Blog</a></p>
  <h1>Tag: {tag}</h1>
  {
    posts.map((post) => (
      <PostCard
        href={postHref(post.id, 'pt')}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        tags={post.data.tags}
        lang="pt"
      />
    ))
  }
</BaseLayout>

<style>
  .crumb {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }
</style>
