---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPage } from '../../lib/pages';

const { Content, data } = await getPage('about', 'pt');
---

<BaseLayout title={`${data.title} · David Silva`} description={data.description} lang="pt-BR">
  <h1>{data.title}</h1>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>

<style>
  .prose :global(ul) {
    padding-left: var(--space-5);
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
</style>
