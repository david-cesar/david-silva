---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { postHref } from '../../lib/blog';
import { createHreflangAlternates } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog-en', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  const portuguesePosts = await getCollection('blog-pt', ({ data }) =>
    import.meta.env.PROD ? data.draft !== true : true,
  );
  return posts.map((post) => {
    const translated = post.data.translationKey
      ? portuguesePosts.find(
          (candidate) =>
            candidate.data.translationKey === post.data.translationKey,
        )
      : undefined;
    const alternates = translated
      ? createHreflangAlternates(
          postHref(post.id, 'en'),
          postHref(translated.id, 'pt'),
        )
      : undefined;

    return {
      params: { slug: post.id },
      props: { post, alternates },
    };
  });
}

const { post, alternates } = Astro.props;
const { Content } = await render(post);
const { data } = post;
---

<PostLayout
  title={data.title}
  description={data.description}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  lang="en"
  linkedinUrl={data.linkedinUrl}
  seoTitle={data.seo?.title}
  seoDescription={data.seo?.description}
  ogImage={data.seo?.image?.src}
  ogImageAlt={data.seo?.image?.alt}
  alternates={alternates}
>
  <Content />
</PostLayout>
