---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/blog';
import { createHreflangAlternates } from '../../lib/seo';

const posts = await getPosts('en');
---

<BaseLayout
  title="AI Engineering Blog | David Silva"
  description="Practical writing on AI engineering, production systems, and the decisions behind building software that works."
  pageKind="collection"
  alternates={createHreflangAlternates('/blog/', '/pt/blog/')}
>
  <h1>Blog</h1>
  {
    posts.length === 0 ? (
      <p>No posts yet.</p>
    ) : (
      posts.map((post) => (
        <PostCard
          href={`/blog/${post.id}/`}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          lang="en"
        />
      ))
    )
  }
</BaseLayout>
