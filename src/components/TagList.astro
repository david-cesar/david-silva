---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
  .tags li {
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.1rem var(--space-2);
  }
</style>
