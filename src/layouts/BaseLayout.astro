---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { createPageGraph, SITE_URL, type HreflangAlternates } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  alternates?: HreflangAlternates;
  pageKind?: 'webpage' | 'profile' | 'collection' | 'article';
  schemaTitle?: string;
  publishDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title: pageTitle,
  description: pageDescription,
  lang = 'en',
  alternates,
  pageKind = 'webpage',
  schemaTitle,
  publishDate,
  updatedDate,
  tags = [],
  ogImage: pageOgImage,
  ogImageAlt: pageOgImageAlt,
} = Astro.props;

const isPortuguese = lang.toLowerCase().startsWith('pt');
const title =
  pageTitle ??
  (isPortuguese
    ? 'David Silva | Engenharia de IA e Software'
    : 'David Silva | AI Engineering and Software');
const description =
  pageDescription ??
  (isPortuguese
    ? 'Textos sobre engenharia de IA, sistemas em produção, ensino e criação de software para resolver problemas reais.'
    : 'Writing about AI engineering, production systems, teaching, and building software that solves real problems.');
const site = Astro.site;
if (!site) {
  throw new Error('Set the production site URL in astro.config.mjs before building SEO metadata.');
}

const canonical = new URL(Astro.url.pathname, site).href;
const homePath = isPortuguese ? '/pt/' : '/';
const blogPath = isPortuguese ? '/pt/blog/' : '/blog/';
const otherLocale = isPortuguese ? 'en' : 'pt-BR';
const alternateHref = alternates?.entries.find(
  (entry) => entry.hreflang === otherLocale,
)?.href;
const languageTarget = alternateHref
  ? new URL(alternateHref).pathname
  : isPortuguese
    ? '/blog/'
    : '/pt/blog/';
const breadcrumbs = [{ name: isPortuguese ? 'Início' : 'Home', url: new URL(homePath, SITE_URL).href }];
if (Astro.url.pathname.includes('/blog/')) {
  breadcrumbs.push({ name: 'Blog', url: new URL(blogPath, SITE_URL).href });
  if (Astro.url.pathname !== blogPath) {
    breadcrumbs.push({ name: schemaTitle ?? title, url: canonical });
  }
} else if (Astro.url.pathname !== homePath) {
  breadcrumbs.push({ name: schemaTitle ?? title, url: canonical });
}

const graph = createPageGraph({
  url: canonical,
  title: schemaTitle ?? title,
  description,
  lang: isPortuguese ? 'pt-BR' : 'en',
  kind: pageKind,
  publishDate,
  updatedDate,
  tags,
  breadcrumbs,
});
const ogImage = pageOgImage
  ? new URL(pageOgImage, SITE_URL).href
  : new URL('/og-default.jpg', SITE_URL).href;
const ogImageAlt =
  pageOgImageAlt ??
  (isPortuguese
    ? 'Prévia do site de David Silva sobre engenharia de software e IA'
    : 'Preview of David Silva’s site about software engineering and AI');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' 'sha256-nufjyycTFo6dF520eSHmTTO4ePge0liyEUcTZ/ohysk=' 'sha256-CNmd9umU/E/YZ0HyzB4ZZY/64Jvs2LFN5IoYy2WwiSc=' 'sha256-VVRzRRentRhYiXrUKm2LXY3Ci5VmudAZvw7NfIKKoZ4=' 'sha256-U1SjTHhmn1ISVhmDXqnc2l2EiwE3hhMPGxwUmASsB3M=' 'sha256-JTYH4qWspnAI14Mff4H85CPAy6rti1uyFSBYRCkqZpA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      siteName="David Silva"
      locale={isPortuguese ? 'pt_BR' : 'en_US'}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={1200}
      ogImageHeight={675}
      twitter={{ card: 'summary_large_image' }}
      author="David Silva"
      graph={graph}
      alternates={alternates}
      extraLinks={[
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        {
          rel: 'alternate',
          type: 'application/rss+xml',
          title: 'David Silva RSS',
          href: '/feed.xml',
        },
      ]}
    />
    <!-- Anti-flash: set theme before first paint -->
    <script is:inline>
      const saved = localStorage.getItem('theme');
      const system = matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
      document.documentElement.dataset.theme = saved || system;
    </script>
  </head>
  <body>
    <Header languageTarget={languageTarget} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
