---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import PostFooter from '../components/PostFooter.astro';
import { formatDate, blogBase, type Lang } from '../lib/blog';
import type { HreflangAlternates } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  lang: Lang;
  linkedinUrl?: string;
  seoTitle?: string;
  seoDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  alternates?: HreflangAlternates;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  lang,
  linkedinUrl,
  seoTitle,
  seoDescription,
  ogImage,
  ogImageAlt,
  alternates,
} = Astro.props;
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
---

<BaseLayout
  title={`${seoTitle ?? title} | David Silva`}
  schemaTitle={title}
  description={seoDescription ?? description}
  lang={htmlLang}
  pageKind="article"
  publishDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  alternates={alternates}
>
  <article>
    <p class="top-back">
      <a href={`${blogBase(lang)}/`}>{lang === 'pt' ? '← Voltar ao blog' : '← Back to blog'}</a>
    </p>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        {
          updatedDate && (
            <span>
              {' '}· {lang === 'pt' ? 'atualizado' : 'updated'}{' '}
              <time datetime={updatedDate.toISOString()}>
                {formatDate(updatedDate, lang)}
              </time>
            </span>
          )
        }
      </p>
      <TagList tags={tags} lang={lang} />
    </header>
    <div class="prose">
      <slot />
    </div>
    <PostFooter title={title} lang={lang} linkedinUrl={linkedinUrl} />
  </article>
</BaseLayout>

<style>
  .top-back {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }
  .post-header {
    margin-bottom: var(--space-6);
  }
  .meta {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: var(--space-5);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
    margin: 0 0 var(--space-4);
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 3px solid var(--accent-soft);
    color: var(--muted);
  }
</style>
