---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatDate, type Lang } from '../lib/blog';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  lang: Lang;
}

const { title, description, pubDate, updatedDate, tags, lang } = Astro.props;
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
---

<BaseLayout title={`${title} · David Silva`} description={description} lang={htmlLang}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        {
          updatedDate && (
            <span>
              {' '}· {lang === 'pt' ? 'atualizado' : 'updated'}{' '}
              <time datetime={updatedDate.toISOString()}>
                {formatDate(updatedDate, lang)}
              </time>
            </span>
          )
        }
      </p>
      <TagList tags={tags} />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: var(--space-6);
  }
  .meta {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0 0 var(--space-3);
  }
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: var(--space-5);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
    margin: 0 0 var(--space-4);
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
  .prose :global(blockquote) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    border-left: 3px solid var(--accent-soft);
    color: var(--muted);
  }
</style>
